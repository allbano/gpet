# Copie para infra/.env. Dados PostgreSQL exigem caminho absoluto; demais caminhos relativos partem da raiz.
# Valores exportados no terminal têm precedência. Não coloque senhas neste arquivo.
# Controle do CLI usado pelos scripts/CI. Para outro projeto no comando direto, use -p NOME.
COMPOSE_PROJECT_NAME=gpet
COMPOSE_FILE=compose.dev.yaml
GPET_IMAGE_TAG=local

# PostgreSQL e backend nos containers.
GPET_DB_NAME=gpet
GPET_DB_USER=gpet
GPET_DB_URL=jdbc:postgresql://db:5432/gpet
# Caminho absoluto para dados persistentes (fora do armazenamento do Docker).
GPET_POSTGRES_DATA_DIR=/var/lib/gpet/postgres
GPET_DB_PASSWORD_FILE=./.secrets/db_password
GPET_ADMIN_PASSWORD_FILE=./.secrets/admin_password
GPET_CONTAINER_DB_PASSWORD_FILE=/run/secrets/db_password
GPET_CONTAINER_ADMIN_PASSWORD_FILE=/run/secrets/admin_password

# Portas locais: PostgreSQL, API, NGINX e Angular com npm start.
GPET_DB_PORT=15432
GPET_BACKEND_PORT=8080
GPET_DEV_HTTP_PORT=8088
GPET_FRONTEND_HOST=127.0.0.1
GPET_FRONTEND_PORT=4200
GPET_DB_DEV_URL=jdbc:postgresql://127.0.0.1:15432/gpet
GPET_COOKIE_SECURE=true
GPET_DEV_COOKIE_SECURE=false

# Produção com TLS. Configure COMPOSE_FILE=compose.yaml ao implantar.
GPET_HTTP_PORT=80
GPET_HTTPS_PORT=443
GPET_TLS_DIR=./infra/tls
GPET_ACME_DIR=./infra/acme
GPET_DEPLOY_DIR=.
GPET_CERTBOT_LIVE_DIR=
GPET_BACKUP_DIR=./backups

# Os testes que alteram contas só rodam com opt-in em um projeto descartável.
GPET_E2E_DISPOSABLE=false
GPET_E2E_URL=http://127.0.0.1:8088
GPET_E2E_PASSWORD_FILE=./.secrets/admin_password
